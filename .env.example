# Copy to .env (git-ignored). Never commit real values.
HANDEL_ENV=local
HANDEL_DATABASE_URL=postgresql+asyncpg://handel:handel@localhost:5432/handel
# replay = recorded fixtures only (default, spends nothing); record = live call + save; live = live only
HANDEL_MODEL_MODE=replay
HANDEL_WORKER_HEARTBEAT_SECONDS=30

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HANDEL_PHONE_ENCRYPTION_KEY=
HANDEL_PHONE_HASH_KEY=

HANDEL_S3_ENDPOINT_URL=http://localhost:9000
HANDEL_S3_BUCKET=handel-media
HANDEL_S3_ACCESS_KEY=handel
HANDEL_S3_SECRET_KEY=handel-local-only

# Filled in once the accounts in docs/accounts.md exist
HANDEL_TELEGRAM_BOT_TOKEN=
HANDEL_TELEGRAM_WEBHOOK_SECRET=
HANDEL_ANTHROPIC_API_KEY=
HANDEL_SARVAM_API_KEY=
HANDEL_VOBIZ_AUTH_ID=
HANDEL_VOBIZ_AUTH_TOKEN=
# Handel's Vobiz number in E.164, e.g. +91XXXXXXXXXX
HANDEL_VOBIZ_NUMBER=
# Public HTTPS base URL (Caddy in the cloud, a Cloudflare quick tunnel locally)
HANDEL_PUBLIC_BASE_URL=
